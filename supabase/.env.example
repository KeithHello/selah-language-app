# Selah Supabase Environment Variables
# Copy to .env and fill in real values. Do NOT commit the real .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# OpenAI (text-generation and transcription features)
OPENAI_API_KEY=sk-your-openai-api-key

# Azure Speech TTS and private audio normalizer
# Fill these only after verifying the Azure resource SKU and private endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_NANO_USD_PER_BILLABLE_CHARACTER=
AZURE_TTS_PRICE_VERSION=
